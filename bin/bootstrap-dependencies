#!/bin/sh
# Fetch only the three explicitly pinned source checkouts used to build Knit.
set -eu
knit_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
knit_parent=$(dirname -- "$knit_root")
checkout() {
    knit_name=$1
    knit_commit=$2
    knit_target=$knit_parent/$knit_name
    if [ ! -e "$knit_target" ]; then
        git clone "https://github.com/archaic-java/$knit_name.git" "$knit_target"
        git -C "$knit_target" checkout --detach "$knit_commit"
    fi
    if [ "$(git -C "$knit_target" rev-parse HEAD)" != "$knit_commit" ] ||
       [ -n "$(git -C "$knit_target" status --porcelain)" ]; then
        echo "Expected clean $knit_name at $knit_commit; leaving existing checkout unchanged" >&2
        exit 1
    fi
}
checkout service-catalog 5265d7bb7549a5325fe39ee26b2ce1f4e4f0aeb3
checkout peep b97658043f3eead9f62569c16b650432c45aaee5
checkout minau 7abc609a7092dc6491d9af299499cfe434ad7f23
